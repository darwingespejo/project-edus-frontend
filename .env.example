# Optional absolute API URL when the PHP API is deployed separately. Leave blank
# to use the local Vite proxy to http://127.0.0.1:8080.
VITE_API_BASE_URL=

# Optional PHP API URL for Vite's local /api proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Public Google Identity Services client ID used by the sign-in button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
